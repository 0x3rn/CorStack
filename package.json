{
  "name": "corstack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "cloudflare:build": "opennextjs-cloudflare build",
    "preview": "npm run cloudflare:build && opennextjs-cloudflare preview",
    "deploy": "npm run cloudflare:build && opennextjs-cloudflare deploy",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:migrate": "tsx --env-file=.env.local scripts/db-migrate.ts",
    "migration": "tsx --env-file=.env.local scripts/migrate-data.ts",
    "db:backup": "tsx --env-file=.env.local scripts/dump-db.mjs",
    "db:seed": "tsx --env-file=.env.local scripts/seed-db.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@next/third-parties": "16.3.8",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "lenis": "^1",
    "lucide-react": "^1.21.0",
    "next": "16.3.8",
    "nextjs-toploader": "^3.9.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.6.0",
    "resend": "^6.14.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@opennextjs/cloudflare": "^1.20.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.59.4",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    }
  }
}
